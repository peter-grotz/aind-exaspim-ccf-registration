#!/usr/bin/env bash
set -ex

# This is the master script for the capsule. When you click "Reproducible Run", the code in this file will execute.

# App-Panel parameter: use the fused CCF brain mask to restrict registration?
# Code Ocean passes the capsule's first parameter as $1 (default true). Accepts
# true/false (also yes/no, 1/0, on/off). A pre-set USE_FUSED_MASK env wins.
export USE_FUSED_MASK="${USE_FUSED_MASK:-${1:-true}}"
echo "USE_FUSED_MASK=${USE_FUSED_MASK}"

python -u main.py

sh run_register_ccf_annotation_10um.sh

python -u finalize_registration_metadata.py

# Reverse-transform the CCF region meshes (.obj) into sample space, reusing the
# transforms produced above. Non-fatal: a failure here must not fail registration.
# Capture output to a results-only log and surface a tail on failure, so a silent
# "failed (non-fatal)" is actually diagnosable on the next run instead of hiding
# the real Python traceback / missing-input message.
INVERT_LOG="/results/ccf_alignment/registration_metadata/ccf_mesh_invert.log"
mkdir -p "$(dirname "$INVERT_LOG")"
if sh run_invert_ccf_objs.sh > "$INVERT_LOG" 2>&1; then
    echo "CCF obj inversion completed (log: ccf_alignment/registration_metadata/ccf_mesh_invert.log)"
else
    echo "CCF obj inversion failed (non-fatal) -- tail of ccf_mesh_invert.log:"
    tail -n 30 "$INVERT_LOG" || true
fi
