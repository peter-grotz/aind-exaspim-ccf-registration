#!/usr/bin/env bash
set -ex

# This is the master script for the capsule. When you click "Reproducible Run", the code in this file will execute.

# App-Panel parameter: use the fused CCF brain mask to restrict registration?
# Code Ocean passes the capsule's first parameter as $1 (default on). Accepts
# yes/no, true/false, 1/0, on/off. A pre-set USE_FUSED_MASK env wins if present.
export USE_FUSED_MASK="${USE_FUSED_MASK:-${1:-true}}"
echo "USE_FUSED_MASK=${USE_FUSED_MASK}"

python -u main.py

sh run_register_ccf_annotation_10um.sh

python -u finalize_registration_metadata.py

# Reverse-transform the CCF region meshes (.obj) into sample space, reusing the
# transforms produced above. Non-fatal: a failure here must not fail registration.
sh run_invert_ccf_objs.sh || echo "CCF obj inversion failed (non-fatal)"
