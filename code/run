#!/usr/bin/env bash
set -ex

# Capsule entry point, run on "Reproducible Run".

# Whether to use the fused CCF brain mask to restrict registration.
# Defaults to $1 (true); an existing USE_FUSED_MASK env var takes precedence.
export USE_FUSED_MASK="${USE_FUSED_MASK:-${1:-true}}"
echo "USE_FUSED_MASK=${USE_FUSED_MASK}"

python -u main.py

sh run_register_ccf_annotation_10um.sh

python -u finalize_registration_metadata.py

# Reverse-transform CCF region meshes (.obj) into sample space. Non-fatal:
# a failure here does not fail registration. Output is logged, and the log
# tail is printed on failure.
INVERT_LOG="/results/ccf_alignment/registration_metadata/ccf_mesh_invert.log"
mkdir -p "$(dirname "$INVERT_LOG")"
if bash run_invert_ccf_objs.sh > "$INVERT_LOG" 2>&1; then
    echo "CCF obj inversion completed (log: ccf_alignment/registration_metadata/ccf_mesh_invert.log)"
else
    echo "CCF obj inversion failed (non-fatal) -- tail of ccf_mesh_invert.log:"
    tail -n 30 "$INVERT_LOG" || true
fi
